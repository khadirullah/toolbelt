#!/usr/bin/env bash
# schedules: cron jobs and systemd timers in one table.
set -uo pipefail
TB_CMD=schedules
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

usage() {
    cat <<'EOF'
usage: schedules [--user | --system] [-a] [--last]

Cron jobs and systemd timers in one table.

Options:
      --user          only your timers and your crontab
      --system        only system timers and system cron files
  -a, --all           include timers that are not active
      --last          last run, how long it took and the result
  -q, --quiet         only the table
  -v, --verbose       every step, and each real command before it runs
  -h, --help          this help

Examples:
  schedules
  schedules --last
  schedules --user
  schedules -a --system

Needs: systemctl for timers. crontab is optional. See man schedules.
Exit: 0 ok, 1 failed, 2 bad usage.
EOF
}

# Tests point this at a fake tree with etc/crontab and etc/cron.d in it.
ROOT=${TB_ROOTFS:-}

SEP=$'\037'

# ---------------------------------------------------------------- time

# Epoch seconds as "16:40 today", "00:00 Wed" or "09:00 Oct 12".
next_text() {
    local t=$1 day today hm dname
    printf -v today '%(%Y-%m-%d)T' -1
    printf -v day '%(%Y-%m-%d)T' "$t"
    printf -v hm '%(%H:%M)T' "$t"
    if [[ $day == "$today" ]]; then
        echo "$hm today"
    elif (( t - NOW < 6 * 86400 )); then
        printf -v dname '%(%a)T' "$t"
        echo "$hm $dname"
    else
        printf -v dname '%(%b %d)T' "$t"
        echo "$hm $dname"
    fi
}

# Epoch seconds in the past as "15:40 today" or "21:30 Sep 28".
last_text() {
    local t=$1 day today hm
    printf -v today '%(%Y-%m-%d)T' -1
    printf -v day '%(%Y-%m-%d)T' "$t"
    printf -v hm '%(%H:%M)T' "$t"
    if [[ $day == "$today" ]]; then
        echo "$hm today"
    else
        printf -v day '%(%b %d)T' "$t"
        echo "$hm $day"
    fi
}

# Seconds as "38m", "5h 28m" or "5d 8h".
left_text() {
    local s=$1
    (( s < 0 )) && s=0
    if (( s < 3600 )); then echo "$(( s / 60 ))m"
    elif (( s < 86400 )); then echo "$(( s / 3600 ))h $(( s % 3600 / 60 ))m"
    else echo "$(( s / 86400 ))d $(( s % 86400 / 3600 ))h"; fi
}

# Seconds as "4s" or "3m 12s".
took_text() {
    local s=$1
    if (( s < 60 )); then echo "${s}s"
    elif (( s < 3600 )); then echo "$(( s / 60 ))m $(( s % 60 ))s"
    else echo "$(( s / 3600 ))h $(( s % 3600 / 60 ))m"; fi
}

# ---------------------------------------------------------------- timers

# One line per timer from systemctl list-timers JSON: next and last in
# epoch seconds (0 for none), the timer and the unit it starts.
timer_lines() {
    local scope=() out
    [[ $1 == user ]] && scope=(--user)
    local cmd=(systemctl ${scope[@]+"${scope[@]}"} list-timers --output=json --no-pager)
    (( all )) && cmd+=(--all)
    tb_show "${cmd[@]}"
    if ! out=$("${cmd[@]}" 2>/dev/null); then
        [[ $1 == user ]] && return 0
        tb_warn "systemctl could not list the timers"
        return 0
    fi
    awk -v RS='}' '
    function num(k,    v) {
        if (match($0, "\"" k "\":[0-9]+")) { v = substr($0, RSTART, RLENGTH); sub(/.*:/, "", v); return int(v / 1000000) }
        return 0
    }
    function str(k,    v) {
        if (match($0, "\"" k "\":\"[^\"]*\"")) { v = substr($0, RSTART, RLENGTH); sub(/^[^:]*:"/, "", v); sub(/"$/, "", v); return v }
        return ""
    }
    { u = str("unit"); if (u != "") printf "%d %d %s %s\n", num("next"), num("last"), u, str("activates") }' <<<"$out"
}

# Result, run time and state for each service, from systemctl show.
# Fills RESULT[service] with "ok", "failed, exit 1" and so on, and TOOK[service].
read_results() {
    local scope=() key val line id="" result="" status="" start=0 stop=0 state=""
    [[ $1 == user ]] && scope=(--user)
    shift
    (( $# )) || return 0
    local cmd=(systemctl ${scope[@]+"${scope[@]}"} show -p Id,Result,ExecMainStatus,ExecMainStartTimestampMonotonic,ExecMainExitTimestampMonotonic,ActiveState "$@")
    tb_show "${cmd[@]}"
    while IFS= read -r line; do
        if [[ -z $line ]]; then
            if [[ -n $id ]]; then
                if [[ $state == activating || $state == active && $stop == 0 && $start != 0 ]]; then
                    RESULT[$id]="running"
                elif [[ $start == 0 ]]; then
                    # Start times count from boot, so a run before this boot shows as 0.
                    RESULT[$id]=""
                elif [[ $result == success ]]; then
                    RESULT[$id]="ok"
                elif [[ $result == exit-code ]]; then
                    RESULT[$id]="failed, exit $status"
                else
                    RESULT[$id]="failed, $result"
                fi
                if (( start > 0 && stop >= start )); then
                    TOOK[$id]=$(( (stop - start) / 1000000 ))
                fi
            fi
            id="" result="" status="" start=0 stop=0 state=""
            continue
        fi
        key=${line%%=*}
        val=${line#*=}
        case $key in
            Id) id=$val ;; Result) result=$val ;; ExecMainStatus) status=$val ;;
            ExecMainStartTimestampMonotonic) start=${val:-0} ;;
            ExecMainExitTimestampMonotonic) stop=${val:-0} ;;
            ActiveState) state=$val ;;
        esac
    done < <("${cmd[@]}" 2>/dev/null; echo)
}

# ---------------------------------------------------------------- cron

# Print "spec<SEP>command<SEP>from" for each job in a crontab file. System
# files have a user field after the time fields.
cron_file() {
    local file=$1 from=$2 has_user=$3 line spec cmd f1 f2 f3 f4 f5 rest
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        # Variable lines such as SHELL=/bin/sh or MAILTO="".
        [[ $line =~ ^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*= ]] && continue
        read -r f1 rest <<<"$line"
        if [[ $f1 == @* ]]; then
            spec=$f1
        else
            read -r f1 f2 f3 f4 f5 rest <<<"$line"
            [[ -n $rest ]] || continue
            spec="$f1 $f2 $f3 $f4 $f5"
        fi
        if (( has_user )); then
            read -r _ cmd <<<"$rest"
        else
            cmd=$rest
        fi
        [[ -n $cmd ]] || continue
        printf '%s%s%s%s%s\n' "$spec" "$SEP" "$cmd" "$SEP" "$from"
    done <"$file"
}

cron_jobs() {
    local f name out
    if [[ $scope != user ]]; then
        if [[ -r $ROOT/etc/crontab ]]; then
            tb_say "reading /etc/crontab"
            cron_file "$ROOT/etc/crontab" "cron, crontab" 1
        fi
        for f in "$ROOT"/etc/cron.d/*; do
            [[ -f $f ]] || continue
            name=${f##*/}
            # cron skips names with dots or a trailing ~, such as package backups.
            [[ $name == *.* || $name == *~ ]] && continue
            if [[ ! -r $f ]]; then
                tb_info "schedules: cannot read /etc/cron.d/$name, run it with sudo to include it"
                continue
            fi
            tb_say "reading /etc/cron.d/$name"
            cron_file "$f" "cron, $name" 1
        done
    fi
    if [[ $scope != system ]] && tb_has crontab; then
        tb_show crontab -l
        if out=$(crontab -l 2>/dev/null); then
            cron_file <(printf '%s\n' "$out") "cron, $(id -un)" 0
        fi
    fi
}

# The next time a cron spec runs after now, as "YYYY-MM-DD HH:MM".
# Reads "index<SEP>spec" lines and prints "index<SEP>time".
cron_next() {
    local y mo d hh mm wd
    read -r y mo d hh mm wd < <(date -d "@$(( NOW + 60 ))" '+%Y %m %d %H %M %w')
    awk -F "$SEP" -v y="$y" -v mo="$mo" -v d="$d" -v hh="$hh" -v mm="$mm" -v wd="$wd" '
    function expand(f, lo, hi, arr, names,    parts, n, i, p, step, a, b, v, r, nm) {
        for (v = lo; v <= hi; v++) arr[v] = 0
        n = split(f, parts, ",")
        for (i = 1; i <= n; i++) {
            p = tolower(parts[i]); step = 1
            if (index(p, "/")) { step = substr(p, index(p, "/") + 1) + 0; p = substr(p, 1, index(p, "/") - 1); if (step < 1) step = 1 }
            if (p == "*") { a = lo; b = hi }
            else if (index(p, "-")) { a = val(substr(p, 1, index(p, "-") - 1), names); b = val(substr(p, index(p, "-") + 1), names) }
            else { a = val(p, names); b = (step > 1) ? hi : a }
            for (v = a; v <= b; v += step) arr[v] = 1
        }
    }
    function val(s, names,    i) {
        if (s ~ /^[0-9]+$/) return s + 0
        i = index(names, substr(s, 1, 3))
        return i ? (i - 1) / 3 : -1
    }
    function dim(y, m) {
        if (m == 2) return (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) ? 29 : 28
        return (m == 4 || m == 6 || m == 9 || m == 11) ? 30 : 31
    }
    {
        n = split($2, f, " ")
        if (n != 5) { print $1 SEP "-"; next }
        delete M; delete H; delete D; delete MO; delete W
        expand(f[1], 0, 59, M, "")
        expand(f[2], 0, 23, H, "")
        expand(f[3], 1, 31, D, "")
        expand(f[4], 1, 12, MO, "   janfebmaraprmayjunjulaugsepoctnovdec")
        expand(f[5], 0, 7, W, "sunmontuewedthufrisat")
        if (W[7]) W[0] = 1
        dstar = (substr(f[3], 1, 1) == "*"); wstar = (substr(f[5], 1, 1) == "*")
        Y = y + 0; Mo = mo + 0; Dd = d + 0; w = wd + 0; first = 1; found = ""
        for (k = 0; k < 366 * 5 && found == ""; k++) {
            if (MO[Mo]) {
                if (dstar || wstar) ok = D[Dd] && W[w]
                else ok = D[Dd] || W[w]
                if (ok) {
                    for (h = (first ? hh + 0 : 0); h <= 23 && found == ""; h++) {
                        if (!H[h]) continue
                        for (m = (first && h == hh + 0 ? mm + 0 : 0); m <= 59; m++)
                            if (M[m]) { found = sprintf("%04d-%02d-%02d %02d:%02d", Y, Mo, Dd, h, m); break }
                    }
                }
            }
            first = 0
            Dd++; w = (w + 1) % 7
            if (Dd > dim(Y, Mo)) { Dd = 1; Mo++; if (Mo > 12) { Mo = 1; Y++ } }
        }
        print $1 SEP (found == "" ? "-" : found)
    }' SEP="$SEP"
}

# A cron command as a short job name.
job_name() {
    local c=$1
    if [[ $c =~ run-parts[^/]*(/etc/cron\.[a-z]+) ]]; then
        echo "${BASH_REMATCH[1]}/*"
        return
    fi
    [[ -n ${HOME:-} ]] && c=${c//$HOME/\~}
    (( ${#c} > 40 )) && c="${c:0:37}..."
    echo "$c"
}

# When each cron command last ran, from the cron lines in the journal.
# Fills CRON_LAST[command] with epoch seconds.
read_cron_runs() {
    tb_has journalctl || return 0
    local cmd=(journalctl -q --no-pager -o short-unix --since -31d -t CRON -t CROND -t crond -t cron)
    tb_show "${cmd[@]}"
    local ts cmdline
    while IFS=$'\t' read -r ts cmdline; do
        CRON_LAST[$cmdline]=$ts
    done < <("${cmd[@]}" 2>/dev/null | awk '{
        i = index($0, " CMD (")
        if (!i) next
        c = substr($0, i + 6)
        sub(/\)[[:space:]]*$/, "", c)
        printf "%d\t%s\n", $1, c
    }')
}

# ---------------------------------------------------------------- main

main() {
    local rows=() line next last unit svc t n=0 failed=0 i
    declare -gA RESULT=() TOOK=() CRON_LAST=()
    printf -v NOW '%(%s)T' -1
    tb_tmpdir work || tb_die 1 "could not make a temp folder"
    : >"$work/rows"

    if tb_has systemctl; then
        local sc services
        for sc in system user; do
            [[ $scope == "$sc" || $scope == both ]] || continue
            services=()
            timer_lines "$sc" >"$work/timers-$sc"
            while read -r next last unit svc; do
                services+=("${svc:-${unit%.timer}.service}")
            done <"$work/timers-$sc"
            read_results "$sc" ${services[@]+"${services[@]}"}
            while read -r next last unit svc; do
                svc=${svc:-${unit%.timer}.service}
                local from=timer
                [[ $sc == user ]] && from="timer, user"
                # sort key, next, last, job, from, result, took
                printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' "$(( next > 0 ? next : 9999999999 ))" "$SEP" "$next" "$SEP" "$last" \
                    "$SEP" "${unit%.timer}" "$SEP" "$from" "$SEP" "${RESULT[$svc]:-}" "$SEP" "${TOOK[$svc]:-}" >>"$work/rows"
            done <"$work/timers-$sc"
        done
    elif [[ $scope != user ]]; then
        tb_info "schedules: no systemctl here, so only cron jobs"
    fi

    cron_jobs >"$work/cron"
    if [[ -s $work/cron ]]; then
        local spec cmdline from nx ep
        if (( show_last )); then read_cron_runs; fi
        awk -F "$SEP" -v S="$SEP" '{
            s = $1
            if (s == "@hourly") s = "0 * * * *"
            else if (s == "@daily" || s == "@midnight") s = "0 0 * * *"
            else if (s == "@weekly") s = "0 0 * * 0"
            else if (s == "@monthly") s = "0 0 1 * *"
            else if (s == "@yearly" || s == "@annually") s = "0 0 1 1 *"
            print NR S s
        }' "$work/cron" | cron_next >"$work/next"
        i=0
        while IFS=$SEP read -r spec cmdline from; do
            i=$(( i + 1 ))
            nx=$(awk -F "$SEP" -v n="$i" '$1 == n { print $2 }' "$work/next")
            if [[ $spec == @reboot ]]; then
                ep=9999999998
                next=boot
            elif [[ $nx == - || -z $nx ]]; then
                ep=9999999999
                next=0
            else
                ep=$(date -d "$nx" +%s 2>/dev/null) || ep=9999999999
                next=$ep
            fi
            last=${CRON_LAST[$cmdline]:-0}
            printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' "$ep" "$SEP" "$next" "$SEP" "$last" "$SEP" "$(job_name "$cmdline")" \
                "$SEP" "$from" "$SEP" "$( (( last > 0 )) && echo ran )" "$SEP" "" >>"$work/rows"
        done <"$work/cron"
        if [[ $scope != user ]] && tb_has systemctl; then
            tb_show systemctl is-active cron.service crond.service cronie.service
            systemctl is-active --quiet cron.service crond.service cronie.service 2>/dev/null ||
                tb_warn "no cron daemon is running, so the cron jobs here do not run"
        fi
    fi

    if [[ ! -s $work/rows ]]; then
        echo "No timers or cron jobs."
        return 0
    fi
    sort -t "$SEP" -k1,1n -k4,4 "$work/rows" >"$work/sorted"

    local w=3 job
    while IFS=$SEP read -r _ _ _ job _; do (( ${#job} > w )) && w=${#job}; done <"$work/sorted"
    (( w > 40 )) && w=40

    local from result took
    if (( show_last )); then
        printf "%s%-${w}s  %-13s  %-7s  %s%s\n" "$C_BOLD" JOB "LAST RUN" TOOK RESULT "$C_OFF"
    else
        printf "%s%-13s  %-8s  %-${w}s  %s%s\n" "$C_BOLD" NEXT LEFT JOB FROM "$C_OFF"
    fi
    while IFS=$SEP read -r _ next last job from result took; do
        n=$(( n + 1 ))
        [[ $result == failed* ]] && failed=$(( failed + 1 ))
        if (( show_last )); then
            local lr="-" tk="-" res=$result
            (( last > 0 )) && lr=$(last_text "$last")
            if [[ -z $res ]]; then
                if (( last > 0 )); then res="earlier boot"; else res="never ran"; fi
            fi
            [[ -n $took ]] && tk=$(took_text "$took")
            [[ $from == cron* && $last == 0 ]] && res="no record"
            [[ $res == failed* ]] && res="${C_RED}$res${C_OFF}"
            printf "%-${w}s  %-13s  %-7s  %s\n" "$job" "$lr" "$tk" "$res"
        else
            local nt="-" lt="-"
            if [[ $next == boot ]]; then
                nt="at boot"
            elif (( next > 0 )); then
                nt=$(next_text "$next")
                lt=$(left_text $(( next - NOW )))
            fi
            printf "%-13s  %-8s  %-${w}s  %s\n" "$nt" "$lt" "$job" "$from"
        fi
    done <"$work/sorted"
    (( TB_QUIET )) && return 0
    local summary
    summary="$(tb_plural "$n" job)"
    if (( failed )); then
        summary+=", $failed failed last time."
        (( show_last )) || summary+=" See: schedules --last"
    else
        summary+="."
    fi
    echo "$summary"
    if (( show_last )) && grep -q "${SEP}cron, " "$work/sorted" && (( EUID != 0 )); then
        tb_info "cron keeps no exit code, so cron jobs only say that they ran. System cron lines in the journal need the systemd-journal group."
    fi
}

scope=both
all=0
show_last=0
tb_expand "" "$@"
set -- ${TB_EXPANDED[@]+"${TB_EXPANDED[@]}"}
while (( $# )); do
    case $1 in
        --user)   [[ $scope == system ]] && tb_usage_error "--user and --system do not go together"
                  scope=user ;;
        --system) [[ $scope == user ]] && tb_usage_error "--user and --system do not go together"
                  scope=system ;;
        -a|--all) all=1 ;;
        --last)   show_last=1 ;;
        -*)       tb_common_opt "$1" || tb_unknown "$1" ;;
        *)        tb_usage_error "schedules takes no names, see --help" ;;
    esac
    shift
done
tb_color_stdout

main
exit $?
