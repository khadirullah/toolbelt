#!/usr/bin/env bash
# fixperms: set folders to 755 and files to 644, with a preview.
set -uo pipefail
TB_CMD=fixperms
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

usage() {
    cat <<'EOF'
usage: fixperms [options] path ...

Set folders to 755 and files to 644, with a preview.

What changes:
  -d, --dirs          change folders only
  -f, --files         change files only
  --private           700 for folders and 600 for files
  --dir-mode MODE     mode for folders, 755 by default
  --file-mode MODE    mode for files, 644 by default
  --no-exec           give every file the file mode, scripts too
  -x, --exclude PAT   leave matching names alone, can repeat

Running:
  -n, --dry-run       show what would change and stop
  --force             allow /, /etc, /usr, /bin, /boot and your home
  -y, --yes           change without asking, the checks still refuse
  -q, --quiet         only the result line
  -v, --verbose       every step, and each real command before it runs
  -h, --help          this help

Examples:
  fixperms ~/site
  fixperms --private ~/notes
  fixperms -x .git -x node_modules ~/code/app
  fixperms -n --files /srv/www/shop

Needs: find, chmod and stat. See man fixperms.
Exit: 0 ok, 1 failed, 2 bad usage, 3 missing tool, 4 refused, 5 answered no.
EOF
}

# The folders fixperms refuses without --force.
PROTECTED=(/ /bin /boot /dev /etc /home /lib /lib32 /lib64 /libx32 /opt /proc /root /run /sbin /srv /sys
           /usr /usr/bin /usr/lib /usr/local /usr/sbin /var)

# The mode for files that run: the file mode with x wherever r is set.
# 644 gives 755, 600 gives 700 and 640 gives 750.
exec_mode() {
    local m=$1 out="" i d
    for (( i = 0; i < ${#m}; i++ )); do
        d=${m:i:1}
        (( d & 4 )) && d=$(( d | 1 ))
        out+="$d"
    done
    echo "$out"
}

# A mode given on the command line, as three octal digits.
check_mode() {
    local m=$2
    [[ $m =~ ^0?[0-7]{3}$ ]] || tb_usage_error "$1 needs a mode such as 755, not $m"
    echo "${m: -3}"
}

# Refuse paths that must not change: system folders, $HOME itself, links.
check_path() {
    local p=$1 real home p2
    if [[ ! -e $p && ! -L $p ]]; then
        tb_die 1 "$p: no such file or folder"
    fi
    real=$(readlink -f -- "$p") || tb_die 1 "$p: could not read the path"
    if (( ! force )); then
        for p2 in "${PROTECTED[@]}"; do
            if [[ $real == "$p2" || $p == "$p2" ]]; then
                tb_die "$E_SAFE" "refused, $p is a system folder and its modes come from your packages. Pass --force if you are sure"
            fi
        done
        home=$(readlink -f -- "$HOME" 2>/dev/null)
        if [[ -n $home && $real == "$home" ]]; then
            tb_die "$E_SAFE" "refused, $p is your home folder and ~/.ssh needs 700 and 600. Pick a folder inside it, or pass --force"
        fi
    fi
    if [[ -L $p ]]; then
        tb_die "$E_SAFE" "refused, $p is a symlink to $(readlink -- "$p"). fixperms never follows links, give the real path"
    fi
}

# Count the paths a find expression prints. Names may hold any byte.
count_find() {
    find -P "$@" -print0 2>/dev/null | tr -dc '\0' | wc -c | tr -d ' '
}

# The most common current modes among the paths a find expression picks,
# such as "777, 775".
modes_now() {
    find -P "$@" -exec stat -c %a -- {} + 2>/dev/null \
        | sort | uniq -c | sort -rn | awk 'NR <= 3 { printf "%s%s", sep, $2; sep = ", " }'
}

# The first names a find expression picks, such as "deploy.sh, bin/run".
names_now() {
    find -P "$@" -print 2>/dev/null | head -n 4 | awk -v n="$1" '
        NR <= 3 { p = $0; if (index(p, n "/") == 1) p = substr(p, length(n) + 2); printf "%s%s", sep, p; sep = ", " }
        NR == 4 { printf ", ..." }'
}

main() {
    local p total_d total_f n_d=0 n_x=0 n_f=0 n_special sum
    (( ${#paths[@]} )) || tb_usage_error "name a folder to fix"
    tb_need find chmod stat
    for p in "${paths[@]}"; do check_path "$p"; done

    # Build the find expressions. The prune part leaves excluded names
    # out, and ! -perm /7000 leaves setuid, setgid and sticky bits alone.
    local prune=() pat first=1
    for pat in ${excludes[@]+"${excludes[@]}"}; do
        (( first )) || prune+=(-o)
        first=0
        if [[ $pat == */* ]]; then prune+=(-path "$pat"); else prune+=(-name "$pat"); fi
    done
    (( ${#prune[@]} )) && prune=( \( "${prune[@]}" \) -prune -o )
    local base=("${paths[@]}" ${prune[@]+"${prune[@]}"})
    local plain=(! -perm /7000)
    local sel_d=(-type d "${plain[@]}" ! -perm "$dmode")
    local sel_x=(-type f "${plain[@]}" -perm /111 ! -perm "$xmode")
    local sel_f=(-type f "${plain[@]}" ! -perm /111 ! -perm "$fmode")
    if (( no_exec )); then
        sel_f=(-type f "${plain[@]}" ! -perm "$fmode")
    fi

    tb_say "counting what would change"
    total_d=$(count_find "${base[@]}" -type d)
    total_f=$(count_find "${base[@]}" -type f)
    (( do_dirs )) && n_d=$(count_find "${base[@]}" "${sel_d[@]}")
    if (( do_files )); then
        (( no_exec )) || n_x=$(count_find "${base[@]}" "${sel_x[@]}")
        n_f=$(count_find "${base[@]}" "${sel_f[@]}")
    fi
    local kinds=(-type d)
    (( do_files )) && kinds=(-type f)
    (( do_dirs && do_files )) && kinds=( \( -type d -o -type f \) )
    n_special=$(count_find "${base[@]}" "${kinds[@]}" -perm /7000)
    sum=$(( n_d + n_x + n_f ))

    local label
    label=$(printf '%s, ' "${paths[@]}")
    label=${label%, }
    tb_color_stdout
    echo "$label has $(tb_plural "$total_d" folder) and $(tb_plural "$total_f" file)."
    if (( n_d )); then
        printf '  %-16s %6s  now %s\n' "folders to $dmode" "$n_d" "$(modes_now "${base[@]}" "${sel_d[@]}")"
    fi
    if (( n_f )); then
        printf '  %-16s %6s  now %s\n' "files to $fmode" "$n_f" "$(modes_now "${base[@]}" "${sel_f[@]}")"
    fi
    if (( n_x )); then
        printf '  %-16s %6s  %s\n' "files to $xmode" "$n_x" "$(names_now "${base[@]}" "${sel_x[@]}")"
    fi
    if (( n_special )); then
        printf '  %-16s %6s  %s\n' "left alone" "$n_special" "setuid, setgid or sticky bit"
    fi
    if (( sum == 0 )); then
        echo "Nothing to change, every mode is already right."
        return 0
    fi
    if (( dry_run )); then
        tb_info "Dry run, nothing changed."
        return 0
    fi
    tb_confirm "Change $(tb_plural "$sum" mode)?"

    local rc=0
    if (( n_d )); then
        tb_show find -P "${base[@]}" "${sel_d[@]}" -exec chmod "$dmode" {} +
        find -P "${base[@]}" "${sel_d[@]}" -exec chmod "$dmode" {} + || rc=1
    fi
    if (( n_x )); then
        tb_show find -P "${base[@]}" "${sel_x[@]}" -exec chmod "$xmode" {} +
        find -P "${base[@]}" "${sel_x[@]}" -exec chmod "$xmode" {} + || rc=1
    fi
    if (( n_f )); then
        tb_show find -P "${base[@]}" "${sel_f[@]}" -exec chmod "$fmode" {} +
        find -P "${base[@]}" "${sel_f[@]}" -exec chmod "$fmode" {} + || rc=1
    fi
    if (( rc )); then
        local left
        left=$(( $( (( do_dirs )) && count_find "${base[@]}" "${sel_d[@]}" || echo 0) \
            + $( (( do_files && ! no_exec )) && count_find "${base[@]}" "${sel_x[@]}" || echo 0) \
            + $( (( do_files )) && count_find "${base[@]}" "${sel_f[@]}" || echo 0) ))
        tb_err "$(( sum - left )) changed, $left could not change. They belong to another user, so run it with sudo"
        return 1
    fi
    echo "$sum changed."
}

paths=()
excludes=()
do_dirs=1
do_files=1
only_dirs=0
only_files=0
private=0
dmode_opt=""
fmode_opt=""
no_exec=0
dry_run=0
force=0
tb_expand "x" "$@"
set -- ${TB_EXPANDED[@]+"${TB_EXPANDED[@]}"}
while (( $# )); do
    case $1 in
        -d|--dirs)     only_dirs=1 ;;
        -f|--files)    only_files=1 ;;
        --private)     private=1 ;;
        --dir-mode)    tb_optarg "$@"; dmode_opt=$(check_mode "$1" "$2") || exit "$E_USAGE"; shift ;;
        --file-mode)   tb_optarg "$@"; fmode_opt=$(check_mode "$1" "$2") || exit "$E_USAGE"; shift ;;
        --no-exec)     no_exec=1 ;;
        -x|--exclude)  tb_optarg "$@"; excludes+=("$2"); shift ;;
        -n|--dry-run)  dry_run=1 ;;
        --force)       force=1 ;;
        --)            shift; paths+=("$@"); break ;;
        -*)            tb_common_opt "$1" || tb_unknown "$1" ;;
        *)             paths+=("$1") ;;
    esac
    shift
done

if (( only_dirs && ! only_files )); then do_files=0; fi
if (( only_files && ! only_dirs )); then do_dirs=0; fi
if (( private )); then
    dmode=${dmode_opt:-700}
    fmode=${fmode_opt:-600}
else
    dmode=${dmode_opt:-755}
    fmode=${fmode_opt:-644}
fi
xmode=$(exec_mode "$fmode")
for i in "${!paths[@]}"; do
    [[ ${paths[i]} != / ]] && paths[i]=${paths[i]%/}
done
unset i

main
exit $?
