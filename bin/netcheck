#!/usr/bin/env bash
# netcheck: find where the network breaks, step by step.
set -uo pipefail
TB_CMD=netcheck
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

usage() {
    cat <<'EOF'
usage: netcheck [options]

Find where the network breaks, step by step.

Options:
  -i, --iface IFACE   check this interface, not the one with the
                      default route
  --host URL          the site for the DNS and HTTPS steps,
                      https://example.com by default
  -q, --quiet         only the verdict, "all good" or "fails at STEP"
  -v, --verbose       every step, and each real command before it runs
  -h, --help          this help

Steps, in order:
  link, address, gateway, internet (ping 1.1.1.1), dns, https

Examples:
  netcheck
  netcheck -i wlp3s0
  netcheck --host https://git.example.com

Needs: ip, ping, getent and curl. See man netcheck.
Exit: 0 all good, 1 a step failed, 2 bad usage, 3 missing tool.
EOF
}

STEPS=(link address gateway internet dns https)
declare -A MARK TEXT

# Record the result of one step.
set_step() {
    MARK[$1]=$2
    TEXT[$1]=$3
}

# A time in seconds as "2.1 ms" or "14 ms".
ms() {
    awk -v s="$1" 'BEGIN { m = s * 1000; if (m < 10) printf "%.1f ms", m; else printf "%d ms", m + 0.5 }'
}

# Two pings. Prints the average round trip in ms, as ping reports it.
ping_avg() {
    local target=$1 dev=() out
    [[ -n $opt_iface ]] && dev=(-I "$opt_iface")
    tb_show ping -c 2 -W 2 "${dev[@]}" "$target"
    out=$(ping -c 2 -W 2 "${dev[@]}" "$target" 2>/dev/null) || return 1
    sed -n 's|.* = [0-9.]*/\([0-9.]*\)/.*|\1|p' <<<"$out" | head -n1
}

# The Wi-Fi name and signal of an interface, as ", Wi-Fi NAME, signal -61 dBm".
wifi_info() {
    local i=$1 name="" level
    [[ -d /sys/class/net/$i/wireless || ( ! -e /sys/class/net/$i && $i == wl* ) ]] || return 0
    if tb_has nmcli; then
        name=$(nmcli -t -g GENERAL.CONNECTION device show "$i" 2>/dev/null | head -n1)
    elif tb_has iw; then
        name=$(iw dev "$i" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p' | head -n1)
    fi
    [[ $name == -- ]] && name=""
    level=$(awk -v i="$i:" '$1 == i { sub(/\.$/, "", $4); print $4 }' /proc/net/wireless 2>/dev/null)
    printf ', Wi-Fi%s' "${name:+ $name}"
    [[ -n $level && $level != 0 ]] && printf ', signal %s dBm' "$level"
    return 0
}

# The DNS server this machine asks, for the dns line.
dns_server() {
    local s
    s=$(awk '$1 == "nameserver" { print $2; exit }' /etc/resolv.conf 2>/dev/null)
    if [[ $s == 127.0.0.53 ]] && tb_has resolvectl; then
        local real
        real=$(resolvectl dns "$iface" 2>/dev/null | sed -n 's/^[^:]*: *//p' | awk '{ print $1; exit }')
        [[ -n $real ]] && s=$real
    fi
    echo "${s:-the system resolver}"
}

step_link() {
    local line state flags
    tb_show ip -brief link show "$iface"
    line=$(ip -brief link show "$iface" 2>/dev/null) || {
        set_step link FAIL "no interface named $iface"
        return 1
    }
    read -r _ state _ flags <<<"$line"
    [[ $flags == \<* ]] || flags=$(grep -o '<[^>]*>' <<<"$line")
    if [[ $state == UP || ( $state == UNKNOWN && $flags == *LOWER_UP* ) ]]; then
        set_step link PASS "$iface up$(wifi_info "$iface")"
        return 0
    fi
    if [[ $flags == *NO-CARRIER* ]]; then
        set_step link FAIL "$iface is up but has no carrier"
    else
        set_step link FAIL "$iface is ${state,,}"
    fi
    return 1
}

step_address() {
    local out addr how
    tb_show ip -4 addr show "$iface"
    out=$(ip -4 addr show "$iface" 2>/dev/null)
    addr=$(awk '$1 == "inet" { print $2; exit }' <<<"$out")
    if [[ -n $addr ]]; then
        if [[ $addr == 169.254.* ]]; then
            set_step address FAIL "only $addr, a self-made address. DHCP gave none"
            return 1
        fi
        how="static"
        grep -q "inet $addr .*dynamic" <<<"$out" && how="from DHCP"
        [[ $how == static ]] && set_step address PASS "$addr, static"
        [[ $how != static ]] && set_step address PASS "$addr $how"
        return 0
    fi
    tb_show ip -6 addr show "$iface" scope global
    addr=$(ip -6 addr show "$iface" scope global 2>/dev/null | awk '$1 == "inet6" { print $2; exit }')
    if [[ -n $addr ]]; then
        set_step address PASS "$addr, IPv6 only"
        return 0
    fi
    set_step address FAIL "$iface has no address"
    return 1
}

step_gateway() {
    local dev=() avg
    [[ -n $opt_iface ]] && dev=(dev "$opt_iface")
    tb_show ip route show default "${dev[@]}"
    gw=$(ip route show default "${dev[@]}" 2>/dev/null |
        awk '{ for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit } }')
    if [[ -z $gw ]]; then
        set_step gateway FAIL "no default route on $iface"
        return 1
    fi
    if avg=$(ping_avg "$gw") && [[ -n $avg ]]; then
        set_step gateway PASS "$gw answers, $(ms "$(awk -v a="$avg" 'BEGIN { print a / 1000 }')")"
        return 0
    fi
    set_step gateway FAIL "$gw does not answer"
    return 1
}

step_internet() {
    local avg
    if avg=$(ping_avg 1.1.1.1) && [[ -n $avg ]]; then
        set_step internet PASS "1.1.1.1 answers, $(ms "$(awk -v a="$avg" 'BEGIN { print a / 1000 }')")"
        return 0
    fi
    # Some networks block ping. A TCP connection to port 443 shows the way out works.
    tb_show timeout 3 bash -c 'exec 3<>/dev/tcp/1.1.1.1/443'
    if timeout 3 bash -c 'exec 3<>/dev/tcp/1.1.1.1/443' 2>/dev/null; then
        set_step internet PASS "1.1.1.1 port 443 answers, ping is blocked here"
        return 0
    fi
    set_step internet FAIL "1.1.1.1 does not answer"
    return 1
}

step_dns() {
    local start took server
    server=$(dns_server)
    tb_show getent ahosts "$host"
    start=$(tb_now_ms)
    if timeout 6 getent ahosts "$host" >/dev/null 2>&1; then
        took=$(( $(tb_now_ms) - start ))
        set_step dns PASS "$host resolves through $server, $took ms"
        return 0
    fi
    set_step dns FAIL "$host does not resolve through $server"
    return 1
}

step_https() {
    local out rc code t
    tb_show curl -s -o /dev/null -w '%{http_code} %{time_total}' --max-time 10 "$url"
    out=$(curl -s -o /dev/null -w '%{http_code} %{time_total}' --max-time 10 "$url" 2>/dev/null)
    rc=$?
    read -r code t <<<"$out"
    if (( rc == 0 )) && [[ ${code:-000} != 000 ]]; then
        set_step https PASS "$url answers $code, $(ms "$t")"
        return 0
    fi
    local why="curl exit $rc"
    case $rc in
        6) why="could not resolve the name" ;;
        7) why="connection refused" ;;
        28) why="no answer in 10s" ;;
        35) why="the TLS handshake failed" ;;
        60) why="the certificate is not trusted, a proxy may be in the way" ;;
    esac
    set_step https FAIL "$url fails, $why"
    return 1
}

# Mark the steps from $2 on as skipped, because $1 failed.
skip_from() {
    local why=$1 start=$2 s go=0
    for s in "${STEPS[@]}"; do
        [[ $s == "$start" ]] && go=1
        (( go )) && set_step "$s" SKIP "$why"
    done
}

run_steps() {
    tb_line "netcheck: link"
    if ! step_link; then
        skip_from "needs link" address
        return
    fi
    tb_line "netcheck: address"
    if ! step_address; then
        skip_from "needs an address" gateway
        return
    fi
    tb_line "netcheck: gateway"
    step_gateway
    tb_line "netcheck: internet"
    step_internet
    if [[ ${MARK[gateway]} == FAIL && ${MARK[internet]} == PASS && -n ${gw:-} ]]; then
        set_step gateway WARN "$gw does not answer ping, but traffic passes through it"
    fi
    tb_line "netcheck: dns"
    if ! step_dns; then
        skip_from "needs dns" https
        return
    fi
    tb_line "netcheck: https"
    step_https
}

# The last line: where the fault is and what to try.
verdict() {
    local first="" s
    for s in "${STEPS[@]}"; do
        if [[ ${MARK[$s]} == FAIL ]]; then
            first=$s
            break
        fi
    done
    if [[ -z $first ]]; then
        if (( TB_QUIET )); then echo "all good"; else echo "netcheck: all good. If a site still fails, the fault is on its side."; fi
        return 0
    fi
    if (( TB_QUIET )); then
        echo "fails at $first"
        return 1
    fi
    local pad="          " fix
    case $first in
        link)
            if [[ ${TEXT[link]} == *"no interface named"* ]]; then
                echo "netcheck: there is no $iface. List the interfaces with: ip -brief link"
            elif [[ -d /sys/class/net/$iface/wireless || $iface == wl* ]]; then
                echo "netcheck: no link on $iface. Connect to a Wi-Fi network:"
                if tb_has nmcli; then echo "${pad}nmcli device wifi list"; else echo "${pad}iw dev $iface scan"; fi
            else
                echo "netcheck: no link on $iface. Plug the cable in, or check the switch port."
            fi
            ;;
        address)
            echo "netcheck: $iface has no address from DHCP. Ask again:"
            if tb_has nmcli; then echo "${pad}nmcli device reapply $iface"; else echo "${pad}sudo dhclient $iface"; fi
            ;;
        gateway)
            echo "netcheck: the router at ${gw:-?} does not answer. Restart it, or move closer to it."
            ;;
        internet)
            if [[ ${MARK[dns]} == PASS && ${MARK[https]} == PASS ]]; then
                echo "netcheck: ping to 1.1.1.1 fails, but DNS and HTTPS work. Something blocks ping."
            else
                echo "netcheck: the router answers but nothing gets past it. The line to your provider is down."
            fi
            ;;
        dns)
            echo "netcheck: the internet works but DNS does not. Try another server:"
            if tb_has resolvectl; then
                fix="resolvectl dns $iface 1.1.1.1"
            elif tb_has nmcli; then
                fix="nmcli connection modify '$(nmcli -t -g GENERAL.CONNECTION device show "$iface" 2>/dev/null)' ipv4.dns 1.1.1.1"
            else
                fix="set nameserver 1.1.1.1 in /etc/resolv.conf"
            fi
            echo "$pad$fix"
            ;;
        https)
            echo "netcheck: DNS works, but $host does not answer over HTTPS. The site may be down, or a firewall or proxy blocks it."
            ;;
    esac
    return 1
}

main() {
    tb_need ip ping getent curl
    if [[ -n $opt_iface ]]; then
        iface=$opt_iface
    else
        tb_show ip route show default
        iface=$(ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
        if [[ -z $iface ]]; then
            iface=$(ip -brief link show up 2>/dev/null | awk '$1 != "lo" { print $1; exit }')
            iface=${iface%%@*}
        fi
        [[ -n $iface ]] || iface=none
    fi
    [[ $url == *://* ]] || url=https://$url
    host=${url#*://}
    host=${host%%/*}
    host=${host##*@}
    host=${host%:*}
    gw=""
    run_steps
    tb_line_end
    tb_color_stdout
    local s col
    if (( ! TB_QUIET )); then
        for s in "${STEPS[@]}"; do
            case ${MARK[$s]} in
                PASS) col=$C_GRN ;; FAIL) col=$C_RED ;; WARN) col=$C_YEL ;; *) col=$C_DIM ;;
            esac
            printf '%-9s %s%-4s%s  %s\n' "$s" "$col" "${MARK[$s]}" "$C_OFF" "${TEXT[$s]}"
        done
    fi
    verdict
}

opt_iface=""
url=https://example.com
tb_expand "i" "$@"
set -- ${TB_EXPANDED[@]+"${TB_EXPANDED[@]}"}
while (( $# )); do
    case $1 in
        -i|--iface) tb_optarg "$@"; opt_iface=$2; shift ;;
        --host)     tb_optarg "$@"; url=$2; shift ;;
        -*)         tb_common_opt "$1" || tb_unknown "$1" ;;
        *)          tb_usage_error "netcheck takes no arguments, got $1. Use --host for a site" ;;
    esac
    shift
done

main
exit $?
