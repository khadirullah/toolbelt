#!/usr/bin/env bash
# ksecret: show a Secret decoded, one key or all.
set -uo pipefail
TB_CMD=ksecret
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
# shellcheck source=../lib/kube.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/kube.sh"

usage() {
    cat <<'EOF'
usage: ksecret [-n NAMESPACE] [--show-keys] NAME [-- kubectl options]
       ksecret [-n NAMESPACE] [-c] NAME KEY [-- kubectl options]

Show a Secret decoded, one key or all.

Options:
  -n, --namespace NS  the Secret's namespace, the context's own by default
  -c, --copy          copy the value of KEY with clip, print nothing
  --show-keys         print private keys too, when showing every key
  -q, --quiet         no header line
  -v, --verbose       every step, and each kubectl command before it runs
  -h, --help          this help

Pass-through:
  Options after -- go to kubectl get secret, such as --context.

Examples:
  ksecret -n shop db-creds
  ksecret -n shop db-creds DB_PASSWORD
  ksecret -c -n shop db-creds DB_PASSWORD
  ksecret -n shop shop-tls -- --context kind-kind

Needs: kubectl, jq and base64. openssl for certificate details.
       See man ksecret.
Exit: 0 ok, 1 no such Secret or key, a binary value for a terminal,
      or kubectl failed, 2 bad usage, 3 missing tool.
EOF
}

# The decoded value of a base64 string on stdout, byte for byte.
decode() { base64 -d <<<"$1" 2>/dev/null; }

# True when the decoded value has control bytes, so it is not text.
is_binary() {
    local n
    n=$(decode "$1" | LC_ALL=C tr -d '\040-\176\200-\377\t\n\r' | wc -c)
    (( n > 0 ))
}

# One line about a PEM certificate: subject, expiry and days left.
cert_line() {
    local out subject end end_s days when
    if ! tb_has openssl; then
        echo "PEM certificate, $1 bytes"
        return
    fi
    out=$(decode "$2" | openssl x509 -noout -subject -enddate -nameopt RFC2253 2>/dev/null)
    subject=$(sed -n 's/^subject=//p' <<<"$out")
    end=$(sed -n 's/^notAfter=//p' <<<"$out")
    if [[ -z $end ]]; then
        echo "PEM data openssl cannot read as a certificate, $1 bytes"
        return
    fi
    end_s=$(date -d "$end" +%s 2>/dev/null) || end_s=""
    if [[ -z $end_s ]]; then
        echo "${subject:-certificate}, expires $end"
        return
    fi
    days=$(( (end_s - $(date +%s)) / 86400 ))
    when=$(date -d "@$end_s" +%F)
    if (( end_s < $(date +%s) )); then
        echo "${subject:-certificate}, expired $when, $(( -days )) days ago"
    else
        echo "${subject:-certificate}, expires $when, $(tb_plural "$days" "day") left"
    fi
}

# One line about a private key: its type and size, never the key.
key_line() {
    local head kind="" bits="" text
    head=$(decode "$1" | grep -m1 -- '-----BEGIN')
    case $head in
        *"ENCRYPTED PRIVATE KEY"*) echo "encrypted private key, hidden, use --show-keys"; return ;;
        *"OPENSSH PRIVATE KEY"*)   echo "OpenSSH private key, hidden, use --show-keys"; return ;;
        *"RSA PRIVATE KEY"*)       kind=RSA ;;
        *"EC PRIVATE KEY"*)        kind=EC ;;
    esac
    if tb_has openssl; then
        # Only the first lines of the text form, which name the type and size.
        text=$(decode "$1" | openssl pkey -passin pass: -noout -text 2>/dev/null |
            awk 'NR == 1 || /^modulus:|^ASN1 OID|^NIST CURVE/' | head -n 4)
        [[ $text =~ \(([0-9]+)\ bit ]] && bits=${BASH_REMATCH[1]}
        case $text in
            *ED25519*) kind=Ed25519 ;;
            *ED448*)   kind=Ed448 ;;
            *modulus:*) kind=RSA ;;
            *"ASN1 OID"*|*"NIST CURVE"*) kind=EC ;;
        esac
    fi
    echo "${kind:+$kind }${bits:+$bits }private key, hidden, use --show-keys"
}

show_all() {
    local k b64 width=0 bytes first line rest
    if (( ! TB_QUIET )); then
        echo "secret $ns/$name, type $type, $(tb_plural "$count" key)"
    fi
    while IFS=$'\t' read -r k _; do
        (( ${#k} > width )) && width=${#k}
    done < "$TMP/data"
    width=$(( width + 2 ))
    while IFS=$'\t' read -r k b64; do
        [[ -n $k ]] || continue
        bytes=$(decode "$b64" | wc -c)
        bytes=${bytes//[[:space:]]/}
        first=$(decode "$b64" | head -c 4096 | tr -d '\0' | grep -m1 -- '-----BEGIN' || true)
        if [[ $first == *"PRIVATE KEY-----"* ]] && (( ! show_keys )); then
            printf "%-${width}s%s\n" "$k" "$(key_line "$b64")"
        elif [[ $first == *"BEGIN CERTIFICATE-----"* ]]; then
            printf "%-${width}s%s\n" "$k" "$(cert_line "$bytes" "$b64")"
        elif (( bytes == 0 )); then
            printf "%-${width}s%s\n" "$k" "(empty)"
        elif is_binary "$b64"; then
            printf "%-${width}s%s\n" "$k" "binary, $bytes bytes, save it with: ksecret -n $ns $name $k > file"
        else
            # Text, with any later lines under the first value column.
            rest=0
            while IFS= read -r line || [[ -n $line ]]; do
                if (( rest )); then
                    printf "%-${width}s%s\n" "" "$line"
                else
                    printf "%-${width}s%s\n" "$k" "$line"
                    rest=1
                fi
            done < <(decode "$b64")
        fi
    done < "$TMP/data"
}

show_key() {
    local b64 keys bytes
    b64=$(awk -F '\t' -v k="$key" '$1 == k { print $2; found = 1; exit } END { exit !found }' "$TMP/data") || {
        mapfile -t keys < <(cut -f1 "$TMP/data")
        if (( ${#keys[@]} )); then
            tb_die 1 "no key $key in secret $ns/$name. Keys are $(join_and "${keys[@]}")"
        fi
        tb_die 1 "no key $key in secret $ns/$name, it has no keys"
    }
    if (( copy )); then
        local clip=clip
        tb_has clip || clip=$TB_ROOT/bin/clip
        bytes=$(decode "$b64" | wc -c)
        bytes=${bytes//[[:space:]]/}
        tb_show_text "base64 -d | clip -q"
        decode "$b64" | "$clip" -q || tb_die 1 "clip could not copy the value"
        tb_info "$TB_CMD: copied $key ($(tb_plural "$bytes" byte)) to the clipboard"
        return 0
    fi
    # Raw bytes would garble the terminal. A pipe or a file still gets them.
    if [[ -t 1 ]] && is_binary "$b64"; then
        bytes=$(decode "$b64" | wc -c)
        tb_err "$key is binary, $(tb_plural "${bytes//[[:space:]]/}" byte). Save it with:"
        printf '  ksecret -n %s %s %s > file\n' "$ns" "$name" "$key" >&2
        return 1
    fi
    decode "$b64"
    # A terminal gets a newline after a value that lacks one, a pipe gets the exact bytes.
    if [[ -t 1 && -n $(decode "$b64" | tail -c 1 | tr -d '\n') ]]; then
        echo
    fi
    return 0
}

main() {
    local hint
    tb_need kubectl jq base64
    tb_tmpdir TMP || tb_die 1 "cannot make a temp folder"
    kube_where
    [[ -n $ns ]] || ns=$KNS
    if ! kube_to "$TMP/secret" get secret "$name" -n "$ns" -o json; then
        if kube_notfound; then
            kube_to "$TMP/names" get secrets -n "$ns" -o name 2>/dev/null
            hint=$(sed 's|^secret/||' "$TMP/names" 2>/dev/null | closest "$name")
            [[ -n $hint ]] && tb_die 1 "no Secret $name in $ns. Did you mean $hint?"
            tb_die 1 "no Secret $name in $ns. List them with: kubectl get secrets -n $ns"
        fi
        kube_fail
    fi
    type=$(jq -r '.type // "Opaque"' "$TMP/secret") || tb_die 1 "kubectl gave output jq cannot read"
    jq -r '(.data // {}) | to_entries[] | "\(.key)\t\(.value)"' "$TMP/secret" > "$TMP/data"
    count=$(grep -c . "$TMP/data")
    tb_say "secret $ns/$name has $(tb_plural "$count" key)"
    if [[ -n $key ]]; then
        show_key
    else
        show_all
    fi
}

ns=""
copy=0
show_keys=0
name=""
key=""
tb_expand "n" "$@"
set -- ${TB_EXPANDED[@]+"${TB_EXPANDED[@]}"}
while (( $# )); do
    case $1 in
        -n|--namespace) tb_optarg "$@"; ns=$2; shift ;;
        -c|--copy)      copy=1 ;;
        --show-keys)    show_keys=1 ;;
        --)             shift; TB_PASS=("$@"); break ;;
        -*)             tb_common_opt "$1" || tb_unknown "$1" ;;
        *)
            if [[ -z $name ]]; then name=${1#secret/}; name=${name#secrets/}
            elif [[ -z $key ]]; then key=$1
            else tb_usage_error "give a Secret and at most one key, not $1 too"; fi ;;
    esac
    shift
done
[[ -n $name ]] || tb_usage_error "give the name of a Secret, such as: ksecret db-creds"
if (( copy )) && [[ -z $key ]]; then
    tb_usage_error "-c copies one value, name the key, such as: ksecret -c $name KEY"
fi

main
exit $?
